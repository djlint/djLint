---
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import { Badge, Code, TabItem, Tabs } from "@astrojs/starlight/components";
import options from "../data/configuration.json";
import { starlightRoute } from "../utils/route";

interface Props {
  label: string;
  placeholder: string;
  empty: string;
}

const { label, placeholder, empty } = Astro.props;
// The llms.txt plugin renders the English page, without a route.
const lang = starlightRoute(Astro.locals)?.locale ?? "en";
const markdown = await createMarkdownProcessor();

/// A djlint.toml takes the pyproject.toml settings without the [tool.djlint] table.
function djlintToml(value: string): string {
  return value
    .replaceAll(/\[tool\.djlint\.(?<table>[^\]]+)\]/gu, "[$<table>]")
    .replaceAll(/\[tool\.djlint\]\n?/gu, "")
    .trim();
}

interface Tab {
  code: string;
  label: string;
  lang: string;
}

function usageTabs(usage: (typeof options)[number]["usage"]): Tab[] {
  return usage.flatMap(({ name, value }) => {
    if (name === "cli") {
      return [{ code: value, label: name, lang: "bash" }];
    }
    if (name === ".djlintrc") {
      return [{ code: value, label: name, lang: "json" }];
    }
    return [
      { code: value, label: name, lang: "toml" },
      // Short enough for the tab bar to fit a phone; .djlint.toml takes the same.
      { code: djlintToml(value), label: "djlint.toml", lang: "toml" },
    ];
  });
}

type Part = { html: string } | { code: string; lang: string };

async function prose(text: string): Promise<Part | null> {
  if (!text.trim()) {
    return null;
  }
  const { code } = await markdown.render(text);
  return { html: code };
}

// Code blocks in a description go through <Code>, like every other code block
// on the site; the plain Markdown processor would use Astro's default theme.
const fence = /^```(?<lang>\w*)\n(?<code>[\s\S]*?)\n```$/gmu;
async function describe(text: string): Promise<Part[]> {
  const parts: (Part | Promise<Part | null>)[] = [];
  let last = 0;
  for (const match of text.matchAll(fence)) {
    parts.push(prose(text.slice(last, match.index)));
    const { code = "", lang: fenceLang = "" } = match.groups ?? {};
    // HTML is highlighted as Twig, as in the pages (see astro.config.mjs).
    parts.push({ code, lang: fenceLang === "html" ? "twig" : fenceLang || "text" });
    last = match.index + match[0].length;
  }
  parts.push(prose(text.slice(last)));
  const resolved = await Promise.all(parts);
  return resolved.filter((part) => part !== null);
}

// The exclude list and the regex defaults are long; on a phone they break
// after a comma or a bar rather than inside a name.
function breakable(value: string): string[] {
  return value.split(/(?<=[,|])/u);
}

const rendered = await Promise.all(
  options
    .toSorted((a, b) => a.name.localeCompare(b.name))
    .map(async (option) => ({
      defaultValue: "default" in option ? option.default : void 0,
      // The flag shows next to the badges, since the cli tab is the last one.
      flag: option.usage.find(({ name }) => name === "cli")?.value.match(/^--[\w-]+/u)?.[0],
      id: option.name.replaceAll("_", "-"),
      name: option.name,
      parts: await describe(option.description[lang] ?? option.description.en),
      since: option.since,
      tabs: usageTabs(option.usage),
      tags: option.tags,
    })),
);
---

<label class="config-filter">
  <span>{label}</span>
  <input id="config-filter" type="search" placeholder={placeholder} />
</label>
<p id="config-empty" role="status" hidden>{empty}</p>

{
  rendered.map((option) => (
    <section class="config-option" data-name={option.name}>
      <h3 id={option.id}>
        <a href={`#${option.id}`}>{option.name}</a>
      </h3>
      <p class="config-tags">
        <Badge text={`${Astro.locals.t("djlint.since")} ${option.since}`} variant="default" />
        {/* The spaces keep "since 1.44.0 formatter linter" apart for screen readers. */}
        {option.tags.map((tag) => (
          <>
            {" "}
            <Badge text={tag} variant="note" />
          </>
        ))}
        {option.flag && (
          <>
            {" "}
            <code>{option.flag}</code>
          </>
        )}
      </p>
      {option.defaultValue !== undefined && (
        <p class="config-default">
          {Astro.locals.t("djlint.default")}{" "}
          {option.defaultValue === null ? (
            Astro.locals.t("djlint.default_none")
          ) : (
            <code>
              {breakable(JSON.stringify(option.defaultValue)).map((part, index) => (
                <>
                  {index > 0 && <wbr />}
                  {part}
                </>
              ))}
            </code>
          )}
        </p>
      )}
      {option.parts.map((part) =>
        "code" in part ? <Code code={part.code} lang={part.lang} /> : <Fragment set:html={part.html} />,
      )}
      <Tabs syncKey="config-file">
        {option.tabs.map((tab) => (
          <TabItem label={tab.label}>
            {/* Print shows every panel, so each one carries its label. */}
            <div class="config-usage" data-label={tab.label}>
              <Code code={tab.code} lang={tab.lang} />
            </div>
          </TabItem>
        ))}
      </Tabs>
    </section>
  ))
}

<script>
  import { requiredData, requiredElement } from "../scripts/dom";

  const filter = requiredElement("#config-filter", HTMLInputElement);
  const empty = requiredElement("#config-empty", HTMLElement);
  const sections = [...document.querySelectorAll<HTMLElement>(".config-option")];
  const list = sections[0]?.parentElement;
  if (!list) {
    throw new TypeError("The page has no options");
  }
  const end = sections.at(-1)?.nextSibling ?? null;

  function matches(text: string, words: readonly string[]): boolean {
    return words.every((word) => text.includes(word));
  }

  filter.addEventListener("input", () => {
    const words = filter.value.toLowerCase().split(/[\s_-]+/u).filter(Boolean);
    for (const section of sections) {
      section.hidden = !matches(section.textContent.toLowerCase(), words);
    }
    empty.hidden = sections.some((section) => !section.hidden);
    // Options named after the search come first, so "ignore" leads with
    // ignore and ignore_blocks rather than with every option that mentions it.
    const named = sections.filter((section) => matches(requiredData(section, "name"), words));
    const others = sections.filter((section) => !named.includes(section));
    for (const section of [...named, ...others]) {
      // oxlint-disable-next-line unicorn/prefer-modern-dom-apis -- end is null when the options end the page
      list.insertBefore(section, end);
    }
  });

  // A link to an option the filter hides (the table of contents lists them
  // all) clears the filter first, so the browser can scroll to it.
  document.addEventListener("click", ({ target }) => {
    const link =
      target instanceof Element ? target.closest<HTMLAnchorElement>('a[href^="#"]') : null;
    const id = link ? CSS.escape(decodeURIComponent(link.hash.slice(1))) : "";
    if (id && document.querySelector(`#${id}`)?.closest<HTMLElement>(".config-option")?.hidden) {
      filter.value = "";
      filter.dispatchEvent(new Event("input"));
    }
  });

  // The table of contents lists every option, more than its panel holds, and
  // Starlight never scrolls the panel to the entry it marks as current. Scroll
  // the panel itself, not with scrollIntoView, which can move the page too.
  function reveal(link: Element | null): void {
    // The desktop panel holds the phone table too, hidden; measuring a hidden
    // link would scroll the panel to nowhere.
    if (!link?.checkVisibility()) {
      return;
    }
    let panel = link.parentElement;
    while (
      panel &&
      !(
        panel.scrollHeight > panel.clientHeight &&
        /auto|scroll/u.test(getComputedStyle(panel).overflowY)
      )
    ) {
      panel = panel.parentElement;
    }
    if (!panel || panel === document.scrollingElement) {
      return;
    }
    const box = link.getBoundingClientRect();
    const view = panel.getBoundingClientRect();
    // The desktop panel starts under the header, which pads its top.
    // oxlint-disable-next-line unicorn/prefer-number-coercion -- Number() reads "4rem" or "56px" as NaN
    const top = view.top + Number.parseFloat(getComputedStyle(panel).paddingTop);
    if (box.top < top) {
      panel.scrollTop -= top - box.top;
    } else if (box.bottom > view.bottom) {
      panel.scrollTop += box.bottom - view.bottom;
    }
  }

  function revealCurrent(toc: Element): void {
    reveal(toc.querySelector('a[aria-current="true"]'));
  }

  for (const toc of document.querySelectorAll("starlight-toc, mobile-starlight-toc")) {
    new MutationObserver(() => {
      revealCurrent(toc);
    }).observe(toc, { attributeFilter: ["aria-current"], subtree: true });
    // The phone menu is closed while the current entry changes.
    toc.querySelector("details")?.addEventListener("toggle", () => {
      revealCurrent(toc);
    });
  }
</script>

<style>
  .config-filter {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-weight: 600;
  }

  .config-filter input {
    padding: 0.5rem 0.75rem;
    font-weight: normal;
    color: var(--sl-color-white);
    background: var(--sl-color-black);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
  }

  .config-option {
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .config-option h3 a {
    color: inherit;
    text-decoration: none;
  }

  .config-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    align-items: center;
  }

  .config-default code {
    overflow-wrap: anywhere;
  }

  /* Starlight's tab padding leaves the four config file tabs too wide for a
     phone, where the last one, cli, would only show on a sideways scroll. */
  @media (width <= 30rem) {
    .config-option :global([role="tab"]) {
      padding-inline: 0.625rem;
      font-size: var(--sl-text-sm);
    }
  }

  /* Paper has no tabs: print every config file's example under its name. */
  @media print {
    .config-filter,
    .config-option :global(.tablist-wrapper) {
      display: none;
    }

    .config-option :global([role="tabpanel"][hidden]) {
      display: block;
    }

    .config-usage::before {
      display: block;
      font-weight: 600;
      content: attr(data-label);
    }
  }
</style>
