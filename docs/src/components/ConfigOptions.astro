---
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import { Badge, Code, TabItem, Tabs } from "@astrojs/starlight/components";
import options from "../data/configuration.json";
import { starlightRoute } from "../utils/route";

interface Props {
  label: string;
  placeholder: string;
  empty: string;
}

const { label, placeholder, empty } = Astro.props;
// llms.txt renders the English page, without a route.
const lang = starlightRoute(Astro.locals)?.locale ?? "en";
const markdown = await createMarkdownProcessor();

// djlint.toml takes the pyproject.toml settings without the [tool.djlint] table.
const djlintToml = (value: string) =>
  value
    .replace(/\[tool\.djlint\.([^\]]+)\]/g, "[$1]")
    .replace(/\[tool\.djlint\]\n?/g, "")
    .trim();

const usageTabs = (usage: (typeof options)[number]["usage"]) =>
  usage.flatMap(({ name, value }) => {
    if (name === "cli") return [{ label: name, lang: "bash", code: value }];
    if (name === ".djlintrc") return [{ label: name, lang: "json", code: value }];
    return [
      { label: name, lang: "toml", code: value },
      // Short enough for the tab bar to fit a phone; .djlint.toml takes the same.
      { label: "djlint.toml", lang: "toml", code: djlintToml(value) },
    ];
  });

// Code blocks in a description go through <Code>, like every other code block
// on the site; the plain Markdown processor would use Astro's default theme.
const fence = /^```(\w*)\n([\s\S]*?)\n```$/gm;
async function describe(text: string) {
  const parts: ({ html: string } | { code: string; lang: string })[] = [];
  let last = 0;
  const prose = async (end: number) => {
    const chunk = text.slice(last, end);
    if (chunk.trim()) parts.push({ html: (await markdown.render(chunk)).code });
  };
  for (const match of text.matchAll(fence)) {
    await prose(match.index);
    // html is highlighted as Twig, as in the pages (see astro.config.mjs).
    parts.push({ lang: match[1] === "html" ? "twig" : match[1] || "text", code: match[2] });
    last = match.index + match[0].length;
  }
  await prose(text.length);
  return parts;
}

// The exclude list and the regex defaults are long; on a phone they break
// after a comma or a bar rather than inside a name.
const breakable = (value: string) => value.split(/(?<=[,|])/);

const rendered = await Promise.all(
  options
    .toSorted((a, b) => a.name.localeCompare(b.name))
    .map(async (option) => ({
      ...option,
      id: option.name.replaceAll("_", "-"),
      parts: await describe(option.description[lang] ?? option.description.en),
      tabs: usageTabs(option.usage),
      // The flag shows next to the badges, since the cli tab is the last one.
      flag: option.usage.find(({ name }) => name === "cli")?.value.match(/^--[\w-]+/)?.[0],
      defaultValue: "default" in option ? option.default : undefined,
    })),
);
---

<label class="config-filter">
  <span>{label}</span>
  <input id="config-filter" type="search" placeholder={placeholder} />
</label>
<p id="config-empty" role="status" hidden>{empty}</p>

{
  rendered.map((option) => (
    <section class="config-option" data-name={option.name}>
      <h3 id={option.id}>
        <a href={`#${option.id}`}>{option.name}</a>
      </h3>
      <p class="config-tags">
        <Badge text={`${Astro.locals.t("djlint.since")} ${option.since}`} variant="default" />
        {/* The spaces keep "since 1.44.0 formatter linter" apart for screen readers. */}
        {option.tags.map((tag) => (
          <>
            {" "}
            <Badge text={tag} variant="note" />
          </>
        ))}
        {option.flag && (
          <>
            {" "}
            <code>{option.flag}</code>
          </>
        )}
      </p>
      {option.defaultValue !== undefined && (
        <p class="config-default">
          {Astro.locals.t("djlint.default")}{" "}
          {option.defaultValue === null ? (
            Astro.locals.t("djlint.default_none")
          ) : (
            <code>
              {breakable(JSON.stringify(option.defaultValue)).map((part, index) => (
                <>
                  {index > 0 && <wbr />}
                  {part}
                </>
              ))}
            </code>
          )}
        </p>
      )}
      {option.parts.map((part) =>
        "code" in part ? <Code code={part.code} lang={part.lang} /> : <Fragment set:html={part.html} />,
      )}
      <Tabs syncKey="config-file">
        {option.tabs.map((tab) => (
          <TabItem label={tab.label}>
            {/* Print shows every panel, so each one carries its label. */}
            <div class="config-usage" data-label={tab.label}>
              <Code code={tab.code} lang={tab.lang} />
            </div>
          </TabItem>
        ))}
      </Tabs>
    </section>
  ))
}

<script>
  const filter = document.querySelector<HTMLInputElement>("#config-filter")!;
  const empty = document.querySelector<HTMLElement>("#config-empty")!;
  const sections = [...document.querySelectorAll<HTMLElement>(".config-option")];
  const list = sections[0]!.parentElement!;
  const end = sections.at(-1)!.nextSibling;

  filter.addEventListener("input", () => {
    const words = filter.value.toLowerCase().split(/[\s_-]+/).filter(Boolean);
    const matches = (text: string) => words.every((word) => text.includes(word));
    for (const section of sections) {
      section.hidden = !matches(section.textContent!.toLowerCase());
    }
    empty.hidden = sections.some((section) => !section.hidden);
    // Options named after the search come first, so "ignore" leads with
    // ignore and ignore_blocks rather than with every option that mentions it.
    const rank = (section: HTMLElement) => (matches(section.dataset.name!) ? 0 : 1);
    for (const section of sections.toSorted((a, b) => rank(a) - rank(b))) {
      list.insertBefore(section, end);
    }
  });

  // A link to an option the filter hides (the table of contents lists them
  // all) clears the filter first, so the browser can scroll to it.
  document.addEventListener("click", (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
    const target = link && document.getElementById(decodeURIComponent(link.hash.slice(1)));
    if (target?.closest<HTMLElement>(".config-option")?.hidden) {
      filter.value = "";
      filter.dispatchEvent(new Event("input"));
    }
  });

  // The table of contents lists every option, more than its panel holds, and
  // Starlight never scrolls the panel to the entry it marks as current. Scroll
  // the panel itself, not with scrollIntoView, which can move the page too.
  function reveal(link: Element | null) {
    // The desktop panel holds the phone table too, hidden; measuring a hidden
    // link would scroll the panel to nowhere.
    if (!link?.checkVisibility()) return;
    let panel = link.parentElement;
    while (
      panel &&
      !(panel.scrollHeight > panel.clientHeight && /auto|scroll/.test(getComputedStyle(panel).overflowY))
    ) {
      panel = panel.parentElement;
    }
    if (!panel || panel === document.scrollingElement) return;
    const box = link.getBoundingClientRect();
    const view = panel.getBoundingClientRect();
    // The desktop panel starts under the header, which pads its top.
    const top = view.top + parseFloat(getComputedStyle(panel).paddingTop);
    if (box.top < top) panel.scrollTop -= top - box.top;
    else if (box.bottom > view.bottom) panel.scrollTop += box.bottom - view.bottom;
  }
  for (const toc of document.querySelectorAll("starlight-toc, mobile-starlight-toc")) {
    const current = () => toc.querySelector('a[aria-current="true"]');
    new MutationObserver(() => reveal(current())).observe(toc, {
      attributeFilter: ["aria-current"],
      subtree: true,
    });
    // The phone menu is closed while the current entry changes.
    toc.querySelector("details")?.addEventListener("toggle", () => reveal(current()));
  }
</script>

<style>
  .config-filter {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-weight: 600;
  }
  .config-filter input {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font: inherit;
    font-weight: normal;
  }
  .config-option {
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
  }
  .config-option h3 a {
    color: inherit;
    text-decoration: none;
  }
  .config-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
  }
  .config-default code {
    overflow-wrap: anywhere;
  }
  /* Starlight's tab padding leaves the four config file tabs too wide for a
     phone, where the last one, cli, would only show on a sideways scroll. */
  @media (max-width: 30rem) {
    .config-option :global([role="tab"]) {
      padding-inline: 0.625rem;
      font-size: var(--sl-text-sm);
    }
  }

  /* Paper has no tabs: print every config file's example under its name. */
  @media print {
    .config-filter,
    .config-option :global(.tablist-wrapper) {
      display: none;
    }
    .config-option :global([role="tabpanel"][hidden]) {
      display: block;
    }
    .config-usage::before {
      content: attr(data-label);
      display: block;
      font-weight: 600;
    }
  }
</style>
