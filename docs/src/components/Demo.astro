---
import { starlightRoute } from "../utils/route";

const { t } = Astro.locals;
// llms.txt renders pages without a route, and the demo has nothing for it.
const route = starlightRoute(Astro.locals);
const prefix = route?.locale ? `/${route.locale}` : "";

// Form fields named after the worker's config keys. A field with a
// placeholder is a text box, one without is a checkbox. `anchor` points at the
// option on the configuration page when its name differs.
const fields = [
  { name: "customBlocks", label: "Custom Blocks", placeholder: "toc,example" },
  { name: "ignoreBlocks", label: "Ignore Blocks", placeholder: "toc,example" },
  { name: "customHtml", label: "Custom HTML", placeholder: "mjml,simple-greeting,mj-\\w+" },
  { name: "indent", label: "Indent", placeholder: "4" },
  { name: "blankLineAfterTag", label: "Blank Line after Tag", placeholder: "load,extends,include" },
  { name: "blankLineBeforeTag", label: "Blank Line before Tag", placeholder: "load,extends,include" },
  { name: "maxLineLength", label: "Max Line Length", placeholder: "80" },
  { name: "maxAttributeLength", label: "Max Attribute Length", placeholder: "0" },
  { name: "maxBlankLines", label: "Max Blank Lines", placeholder: "0" },
  { name: "formatAttributeTemplateTags", label: "Format Attribute Template Tags" },
  { name: "singleAttributePerLine", label: "Single Attribute Per Line" },
  { name: "formatAttributeJsJson", label: "Format Attribute JS/JSON" },
  { name: "formatAttributeJsJsonPattern", label: "Attribute JS/JSON Pattern", placeholder: "^(on[a-z]+|x-[a-z-]+)$" },
  { name: "formatAttributeJsJsonMinProps", label: "Attribute JS/JSON Min Props", placeholder: "2" },
  { name: "preserveLeadingSpace", label: "Preserve Leading Space" },
  { name: "preserveBlankSpace", label: "Preserve Blank Space", anchor: "preserve-blank-lines" },
  { name: "preserveClassNewlines", label: "Preserve Class Newlines" },
  { name: "formatJs", label: "Format JS" },
  { name: "indentJs", label: "JS Indent", placeholder: "4", anchor: "format-js" },
  { name: "formatCss", label: "Format CSS" },
  { name: "indentCss", label: "CSS Indent", placeholder: "4", anchor: "format-css" },
  { name: "closeVoidTags", label: "Close Void Tags" },
  { name: "ignoreCase", label: "Ignore Case" },
  { name: "lineBreakAfterMultilineTag", label: "Line Break After Multiline Tag" },
  { name: "noLineAfterYaml", label: "No Line After YAML" },
  { name: "noFunctionFormatting", label: "No Function Formatting" },
  { name: "noSetFormatting", label: "No Set Formatting" },
];

const profiles = [
  ["", "none (default)"],
  ["html", "html"],
  ["django", "django"],
  ["jinja", "jinja"],
  ["nunjucks", "nunjucks (nunjucks and twig)"],
  ["handlebars", "handlebars (handlebars and mustache)"],
  ["liquid", "liquid"],
  ["golang", "golang (go templates)"],
  ["angular", "angular"],
  ["tera", "tera"],
  ["askama", "askama"],
  ["mako", "mako"],
];

const kebab = (name: string) => name.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`);
const help = (anchor: string) => `${prefix}/docs/configuration/#${anchor}`;
// What a "?" link says to a screen reader: which option's documentation it opens.
// The fields get their names from aria-label, so the link doesn't join them.
const helpLabel = (label: string) => `${t("djlint.configuration")}: ${label}`;
---

{
  route && (
    <div class="demo not-content">
      <p>{t("djlint.demo_description")} <small id="djlint-version"></small></p>
      <p
        id="djlint-status"
        role="status"
        data-installing={t("djlint.demo_installing")}
        data-version={t("djlint.demo_version")}
        data-error={t("djlint.demo_error")}
      >
        {t("djlint.demo_loading")}
      </p>

      <div class="demo-workspace" hidden>
        <form id="djlint-settings">
          <label>
            <span>Profile <a href={help("profile")} target="_blank" aria-label={helpLabel("Profile")}>?</a></span>
            <select name="profile" aria-label="Profile">
              {profiles.map(([value, text]) => <option value={value}>{text}</option>)}
            </select>
          </label>
          {
            fields.map(({ name, label, placeholder, anchor }) => (
              <label class:list={{ checkbox: !placeholder }}>
                {placeholder ? null : <input name={name} type="checkbox" aria-label={label} />}
                <span>
                  {label} <a href={help(anchor ?? kebab(name))} target="_blank" aria-label={helpLabel(label)}>
                    ?
                  </a>
                </span>
                {placeholder ? (
                  <input name={name} type="text" placeholder={placeholder} aria-label={label} />
                ) : null}
              </label>
            ))
          }
        </form>
        <div class="demo-editors">
          <section>
            <div class="demo-head">
              <span id="djlint-input-label">input.html</span>
              <button type="button" id="djlint-share" data-copied={t("djlint.copied")}>
                {t("djlint.demo_copy_link")}
              </button>
              <span class="sr-only" role="status" id="djlint-share-status"></span>
            </div>
            <div class="demo-editor" id="djlint-input"></div>
          </section>
          <section>
            <p class="demo-head" id="djlint-output-label">
              <span><span class="prompt" aria-hidden="true">$</span> djlint input.html --reformat</span>
            </p>
            <div class="demo-editor" id="djlint-output"></div>
          </section>
        </div>
      </div>
    </div>
  )
}

<script>
  import { jinja } from "@codemirror/lang-jinja";
  import { EditorState } from "@codemirror/state";
  import { basicSetup, EditorView } from "codemirror";
  import { decodeState, encodeState } from "../scripts/demo-state";
  import { djlintEditorTheme } from "../scripts/editor-theme.js";

  const WELCOME = "<div>\n    <p>Welcome to djLint online!</p>\n</div>";
  const status = document.getElementById("djlint-status")!;
  const form = document.querySelector<HTMLFormElement>("#djlint-settings")!;
  const worker = new Worker("/static/js/worker.js", { type: "module" });
  let sessionId = 0;

  const editorState = (label: string, extensions: object[], doc = "") =>
    EditorState.create({
      doc,
      extensions: [
        basicSetup,
        // HTML with the {{ }}, {% %} and {# #} tags of Django, Jinja, Nunjucks and Twig.
        jinja(),
        djlintEditorTheme,
        EditorView.contentAttributes.of({ "aria-labelledby": label }),
        ...extensions,
      ],
    });

  function getConfig() {
    const config: Record<string, string | boolean> = {};
    for (const field of form.querySelectorAll<HTMLInputElement>("[name]")) {
      const value = field.type === "checkbox" ? field.checked : field.value;
      if (value) config[field.name] = value;
    }
    return config;
  }

  function setConfig(config: Record<string, string | boolean>) {
    for (const field of form.querySelectorAll<HTMLInputElement>("[name]")) {
      const value = config[field.name];
      if (field.type === "checkbox") field.checked = value === true;
      else field.value = typeof value === "string" ? value : "";
    }
  }

  // The address always holds the current example, so it can be shared as is.
  // The welcome example with no settings keeps the plain address.
  async function exampleUrl(html: string, config: Record<string, string | boolean>) {
    const plain = html === WELCOME && Object.keys(config).length === 0;
    const hash = plain ? "" : `#${await encodeState({ html, config })}`;
    return `${location.origin}${location.pathname}${hash}`;
  }

  async function saveState(html: string, config: Record<string, string | boolean>, id: number) {
    const url = await exampleUrl(html, config);
    if (id === sessionId) history.replaceState(null, "", url);
  }

  function format() {
    sessionId += 1;
    const config = getConfig();
    const html = input.state.doc.toString();
    worker.postMessage({ config, html, id: sessionId });
    void saveState(html, config, sessionId);
  }

  // A later restore wins over an earlier one that is still decoding.
  let restoreId = 0;
  async function restore() {
    const id = ++restoreId;
    const hash = location.hash.slice(1);
    // No hash is the welcome example (going back to the plain address); a hash
    // that doesn't decode, such as #_top from the skip link, changes nothing.
    const state = hash ? await decodeState(hash) : { html: WELCOME, config: {} };
    if (!state || id !== restoreId) return;
    setConfig(state.config);
    if (state.html !== input.state.doc.toString()) {
      input.dispatch({ changes: { from: 0, to: input.state.doc.length, insert: state.html } });
    } else {
      format();
    }
  }

  let timer: ReturnType<typeof setTimeout>;
  const input = new EditorView({
    parent: document.getElementById("djlint-input")!,
    state: editorState(
      "djlint-input-label",
      [
        EditorView.updateListener.of((update) => {
          if (!update.docChanged) return;
          clearTimeout(timer);
          timer = setTimeout(format, 100);
        }),
      ],
      WELCOME,
    ),
  });
  const restored = restore();
  addEventListener("hashchange", restore);
  const output = new EditorView({
    parent: document.getElementById("djlint-output")!,
    state: editorState("djlint-output-label", [EditorState.readOnly.of(true)]),
  });

  // The worker reports its progress as codes; the page holds their translations.
  const showError = () => {
    status.textContent = status.dataset.error!;
  };
  worker.onerror = showError;
  worker.onmessage = ({ data: { id, type, message } }) => {
    if (type === "status" && message === "ready") {
      status.hidden = true;
      document.querySelector<HTMLElement>(".demo-workspace")!.hidden = false;
      void restored.then(format);
    } else if (type === "status" && message === "error") {
      showError();
    } else if (type === "status" && message === "installing") {
      status.textContent = status.dataset.installing!;
    } else if (type === "version") {
      document.getElementById("djlint-version")!.textContent = status.dataset
        .version!.replace("{python}", message.python)
        .replace("{djlint}", message.djlint);
    } else if ((type === "html" || type === "error") && id === sessionId) {
      output.dispatch({ changes: { from: 0, to: output.state.doc.length, insert: message } });
    }
  };

  form.addEventListener("change", format);

  // "Copied" goes to a status region: a changed label on the focused button is
  // not reliably announced.
  const share = document.querySelector<HTMLButtonElement>("#djlint-share")!;
  const shareStatus = document.getElementById("djlint-share-status")!;
  const shareLabel = share.textContent!.trim();
  let shareTimer: ReturnType<typeof setTimeout> | undefined;
  share.addEventListener("click", async () => {
    // The link is made from the editor as it is now, not from the address,
    // which waits for the debounce. Safari only lets the click itself write
    // to the clipboard, so the link goes in as a promise.
    const url = exampleUrl(input.state.doc.toString(), getConfig());
    const blob = url.then((text) => new Blob([text], { type: "text/plain" }));
    try {
      await navigator.clipboard.write([new ClipboardItem({ "text/plain": blob })]);
    } catch {
      // A browser without promises in ClipboardItem gets the finished text.
      try {
        await navigator.clipboard.writeText(await url);
      } catch {
        return; // Clipboard access was denied; the address bar has the link too.
      }
    }
    clearTimeout(shareTimer);
    share.textContent = shareStatus.textContent = share.dataset.copied!;
    shareTimer = setTimeout(() => {
      share.textContent = shareLabel;
      shareStatus.textContent = "";
    }, 1500);
  });
</script>

<style>
  /* The splash template caps content at reading width; the editors need the
     whole page column, which custom.css already caps for wide screens. */
  :global(main:has(.demo) .sl-container) {
    max-width: none;
  }
  .demo-workspace:not([hidden]) {
    display: grid;
    grid-template-columns: 16rem 1fr;
    gap: 1.5rem;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-height: 75vh;
    overflow-y: auto;
    font-size: var(--sl-text-sm);
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin: 0;
  }
  label.checkbox {
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
  }
  /* A ringed "?" after each label: the ring sets the link apart from the text. */
  form a {
    display: inline-grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    color: var(--sl-color-gray-3);
    font-size: 0.7rem;
    line-height: 1;
    text-decoration: none;
    vertical-align: middle;
  }
  form a:hover {
    color: var(--sl-color-white);
  }
  input[type="text"],
  select {
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font: inherit;
  }
  .demo-editors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 0;
  }
  .demo-editors section {
    margin: 0;
    border: 1px solid var(--dj-code-line);
    border-radius: 0.75rem;
    overflow: hidden;
    background: var(--dj-code-bg);
    /* The editors are dark in both themes, and so are their scrollbars. */
    color-scheme: dark;
  }
  /* Both heads are as tall as the one with the button, so the editors line up. */
  .demo-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 2.875rem;
    margin: 0;
    padding: 0.4rem 1rem;
    border-bottom: 1px solid var(--dj-code-line);
    color: #a9b1d6;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
  }
  .demo-head button {
    margin-inline-start: auto;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--dj-code-line);
    border-radius: 0.375rem;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .demo-head button:hover {
    border-color: #7d84ad;
    color: #c0caf5;
  }
  .demo-head .prompt {
    color: var(--dj-squiggle);
  }
  #djlint-status {
    color: var(--sl-color-gray-3);
  }
  .demo-editor {
    height: 70vh;
    margin: 0;
  }
  @media (max-width: 60rem) {
    .demo-workspace:not([hidden]),
    .demo-editors {
      grid-template-columns: 1fr;
    }
    form {
      max-height: none;
    }
    .demo-editor {
      height: 40vh;
    }
  }
</style>
