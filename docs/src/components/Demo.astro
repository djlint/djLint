---
import help from "../data/cli-help.txt?raw";
import options from "../data/configuration.json";
import labels from "../data/demo-labels.json";
import { starlightRoute } from "../utils/route";

const { t } = Astro.locals;
// llms.txt renders pages without a route, and the demo has nothing for it.
const route = starlightRoute(Astro.locals);
const prefix = route?.locale ? `/${route.locale}` : "";

// The options, named as in djLint's Python API, grouped and ordered as in
// `djlint --help`. Their labels are in demo-labels.json; the hints and the CLI
// view show the flags. A field with options is a
// menu, one with a placeholder takes a value (a number when the placeholder is
// one, which is then its default), any other is a switch. `anchor` is the
// option's section on the configuration page, where it differs from its name.
type Field = { name: string; placeholder?: string; options?: string[][]; anchor?: string };
const groups: { legend?: string; fields: Field[] }[] = [
  {
    fields: [
      {
        name: "profile",
        options: [
          ["", "none"],
          ["html", "html"],
          ["django", "django"],
          ["jinja", "jinja"],
          ["nunjucks", "nunjucks (and twig)"],
          ["handlebars", "handlebars (and mustache)"],
          ["liquid", "liquid"],
          ["golang", "golang (go templates)"],
          ["angular", "angular"],
          ["tera", "tera"],
          ["askama", "askama"],
          ["mako", "mako"],
        ],
      },
    ],
  },
  {
    legend: t("djlint.linter"),
    fields: [
      { name: "ignore", placeholder: "H014,H015" },
      { name: "include", placeholder: "H017,T027" },
    ],
  },
  {
    legend: t("djlint.demo_layout"),
    fields: [
      { name: "indent", placeholder: "4" },
      { name: "max_line_length", placeholder: "120" },
      { name: "max_attribute_length", placeholder: "70" },
      { name: "single_attribute_per_line" },
      { name: "line_break_after_multiline_tag" },
      { name: "no_indent_inner_html" },
      { name: "keep_br_inline" },
      { name: "custom_blocks", placeholder: "toc,example" },
      { name: "custom_html", placeholder: "mjml,simple-greeting,mj-\\w+" },
      { name: "ignore_blocks", placeholder: "raw,example" },
      { name: "blank_line_after_tag", placeholder: "load,extends,include" },
      { name: "blank_line_before_tag", placeholder: "load,extends,include" },
      { name: "max_blank_lines", placeholder: "0" },
      { name: "preserve_blank_lines" },
      { name: "preserve_leading_space" },
      { name: "no_line_after_yaml" },
    ],
  },
  {
    legend: t("djlint.demo_rewrites"),
    fields: [
      { name: "close_void_tags" },
      { name: "ignore_case" },
      { name: "sort_attributes" },
      { name: "sort_load_tags" },
      { name: "name_endblocks" },
      { name: "quote_style", options: [["", "double"], ["single", "single"]] },
      { name: "no_entity_formatting" },
      { name: "no_function_formatting" },
      { name: "no_set_formatting" },
      { name: "preserve_class_newlines" },
      { name: "format_attribute_template_tags" },
    ],
  },
  {
    legend: t("djlint.demo_css_js"),
    fields: [
      { name: "format_css" },
      { name: "indent_css", placeholder: "4", anchor: "format-css" },
      { name: "format_js" },
      { name: "indent_js", placeholder: "4", anchor: "format-js" },
      { name: "format_attribute_js_json" },
      { name: "format_attribute_js_json_pattern", placeholder: "^(on[a-z]+|x-[a-z-]+)$" },
      { name: "format_attribute_js_json_min_props", placeholder: "2" },
    ],
  },
];

// What the output panel can show: the formatted template, or the settings as
// commands or as a configuration file.
const views = [
  ["output", t("djlint.demo_output")],
  ["cli", "CLI"],
  ["pyproject.toml", "pyproject.toml"],
  ["djlint.toml", "djlint.toml"],
  [".djlintrc", ".djlintrc"],
];

const kebab = (name: string) => name.replaceAll("_", "-");

// What a "?" says on hover: the option's description from the configuration
// page, up to its first example, or the --help line of an option the page
// has no section for (the CSS and JS indents).
const lang = route?.locale ?? "en";
const descriptions = new Map(
  options.map(({ name, description }) => [
    name,
    (description as Record<string, string>)[lang] ?? description.en,
  ]),
);
const helpLines = new Map(
  [...help.matchAll(/^ {2}--([\w-]+)[^\n]*? {2,}(\S.*(?:\n {34}\S.*)*)/gm)].map(([, flag, text]) => [
    flag,
    text.replace(/\s+/g, " ").replace(/ \[default: [^\]]+\]$/, ""),
  ]),
);
const escape = (text: string) => text.replaceAll("&", "&amp;").replaceAll("<", "&lt;");
const hint = (name: string) => {
  const text = descriptions.get(name)?.split(/\n\n|```/)[0] ?? helpLines.get(kebab(name)) ?? "";
  const prose = escape(text.trim())
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
    .replace(/`([^`]+)`/g, "<code>$1</code>");
  return `<code class="flag">--${kebab(name)}</code> ${prose}`;
};
const label = (name: string) => {
  const texts: Record<string, string> = labels[name as keyof typeof labels];
  return texts[lang] ?? texts.en;
};
const docs = (anchor: string) => `${prefix}/docs/configuration/#${anchor}`;
// What a "?" link says to a screen reader: which option's documentation it opens.
// The fields get their names from aria-label, so the link doesn't join them.
const helpLabel = (text: string) => `${t("djlint.configuration")}: ${text}`;
---

{
  route && (
    <div class="demo not-content">
      <p>{t("djlint.demo_description")} <small id="djlint-version" /></p>
      {/* What djLint says about the settings, such as a rule code it doesn't know. */}
      <ul class="demo-warnings" id="djlint-warnings" role="status" />

      <div class="demo-workspace">
        <details class="demo-settings" open>
          <summary>{t("djlint.demo_options")}</summary>
          <form id="djlint-settings">
            {groups.map(({ legend, fields }) => (
              <fieldset>
                {legend && <legend>{legend}</legend>}
                {fields.map(({ name, placeholder, options, anchor }) => {
                  const text = label(name);
                  const toggle = !placeholder && !options;
                  return (
                    <label class:list={{ checkbox: toggle }}>
                      {toggle && <input name={name} type="checkbox" aria-label={text} />}
                      <span>
                        {text}{" "}
                        <a
                          href={docs(anchor ?? kebab(name))}
                          target="_blank"
                          aria-label={helpLabel(text)}
                          aria-describedby={`djlint-hint-${name}`}
                        >
                          ?
                        </a>
                      </span>
                      <span id={`djlint-hint-${name}`} hidden set:html={hint(name)} />
                      {options && (
                        <select name={name} aria-label={text}>
                          {options.map(([value, text]) => (
                            <option value={value}>{text}</option>
                          ))}
                        </select>
                      )}
                      {placeholder && (
                        <input
                          name={name}
                          type={/^\d+$/.test(placeholder) ? "number" : "text"}
                          min="0"
                          placeholder={placeholder}
                          aria-label={text}
                        />
                      )}
                    </label>
                  );
                })}
              </fieldset>
            ))}
          </form>
        </details>
        {/* Side by side the settings stay open; above the editors they start closed. */}
        <script is:inline>
          document.currentScript.previousElementSibling.open = matchMedia("(width >= 60rem)").matches;
        </script>
        <div class="demo-editors">
          <section>
            <div class="demo-head">
              <span id="djlint-input-label">input.html</span>
              <span
                id="djlint-problems"
                data-count={t("djlint.demo_problems")}
                data-clean={t("djlint.hero_clean")}
              />
              <button type="button" id="djlint-share" data-copied={t("djlint.copied")}>
                {t("djlint.demo_copy_link")}
              </button>
              <span class="sr-only" role="status" id="djlint-share-status" />
            </div>
            <div class="demo-editor" id="djlint-input" />
          </section>
          <section>
            <div class="demo-head">
              <div class="views">
                {views.map(([view, label], i) => (
                  <button
                    type="button"
                    id={`djlint-view-${i}`}
                    data-view={view}
                    aria-pressed={i === 0 ? "true" : "false"}
                  >
                    {label}
                  </button>
                ))}
              </div>
              <button type="button" id="djlint-copy" data-copied={t("djlint.copied")}>
                {t("djlint.copy")}
              </button>
              <span class="sr-only" role="status" id="djlint-copy-status" />
            </div>
            <div class="demo-editor" id="djlint-output" data-defaults={t("djlint.demo_defaults")} />
            <p
              class="sr-only"
              id="djlint-status"
              role="status"
              data-version={t("djlint.demo_version")}
              data-error={t("djlint.demo_error")}
            >
              {t("djlint.demo_loading")}
            </p>
          </section>
        </div>
      </div>
      <div class="demo-hint" id="djlint-hint" aria-hidden="true" hidden />
    </div>
  )
}

<script>
  import { jinja } from "@codemirror/lang-jinja";
  import { StreamLanguage } from "@codemirror/language";
  import { json } from "@codemirror/legacy-modes/mode/javascript";
  import { shell } from "@codemirror/legacy-modes/mode/shell";
  import { toml } from "@codemirror/legacy-modes/mode/toml";
  import { type Diagnostic, setDiagnostics } from "@codemirror/lint";
  import { Compartment, EditorState, type Extension, type Text } from "@codemirror/state";
  import { placeholder } from "@codemirror/view";
  import { basicSetup, EditorView } from "codemirror";
  import { apiOptions, commands, configFile, type DemoConfig } from "../scripts/demo-config";
  import { decodeState, encodeState } from "../scripts/demo-state";
  import { djlintEditorTheme } from "../scripts/editor-theme.js";

  const WELCOME = "<div>\n    <p>Welcome to djLint online!</p>\n</div>";
  const status = document.getElementById("djlint-status")!;
  const problems = document.getElementById("djlint-problems")!;
  const form = document.querySelector<HTMLFormElement>("#djlint-settings")!;
  const worker = new Worker("/static/js/worker.js", { type: "module" });
  let sessionId = 0;

  // HTML with the {{ }}, {% %} and {# #} tags of Django, Jinja, Nunjucks and Twig.
  const template = jinja();
  const editorState = (extensions: Extension[], doc = "") =>
    EditorState.create({ doc, extensions: [basicSetup, djlintEditorTheme, ...extensions] });
  const labelledBy = (id: string) => EditorView.contentAttributes.of({ "aria-labelledby": id });

  function getConfig() {
    const config: DemoConfig = {};
    for (const field of form.querySelectorAll<HTMLInputElement>("[name]")) {
      const value = field.type === "checkbox" ? field.checked : field.value;
      if (value) config[field.name] = value;
    }
    return config;
  }

  function setConfig(config: DemoConfig) {
    for (const field of form.querySelectorAll<HTMLInputElement>("[name]")) {
      const value = config[field.name];
      if (field.type === "checkbox") field.checked = value === true;
      else field.value = typeof value === "string" ? value : "";
    }
  }

  // The address always holds the current example, so it can be shared as is.
  // The welcome example with no settings keeps the plain address.
  async function exampleUrl(html: string, config: DemoConfig) {
    const plain = html === WELCOME && Object.keys(config).length === 0;
    const hash = plain ? "" : `#${await encodeState({ html, config })}`;
    return `${location.origin}${location.pathname}${hash}`;
  }

  async function saveState(html: string, config: DemoConfig, id: number) {
    const url = await exampleUrl(html, config);
    if (id === sessionId) history.replaceState(null, "", url);
  }

  // The input the worker is formatting and linting now: findings for any
  // other text would land in the wrong places.
  let requested: Text | undefined;
  function format() {
    sessionId += 1;
    const config = getConfig();
    requested = input.state.doc;
    worker.postMessage({ options: apiOptions(config), html: requested.toString(), id: sessionId });
    void saveState(requested.toString(), config, sessionId);
    if (view !== "output") showOutput();
  }

  // A later restore wins over an earlier one that is still decoding.
  let restoreId = 0;
  async function restore() {
    const id = ++restoreId;
    const hash = location.hash.slice(1);
    // No hash is the welcome example (going back to the plain address); a hash
    // that doesn't decode, such as #_top from the skip link, changes nothing.
    const state = hash ? await decodeState(hash) : { html: WELCOME, config: {} };
    if (!state || id !== restoreId) return;
    setConfig(state.config);
    if (state.html !== input.state.doc.toString()) {
      input.dispatch({ changes: { from: 0, to: input.state.doc.length, insert: state.html } });
    } else {
      format();
    }
  }

  // Typing in the editor or a field formats once the typing pauses.
  let timer: ReturnType<typeof setTimeout>;
  const formatSoon = () => {
    clearTimeout(timer);
    timer = setTimeout(format, 100);
  };
  const input = new EditorView({
    parent: document.getElementById("djlint-input")!,
    state: editorState(
      [
        template,
        labelledBy("djlint-input-label"),
        EditorView.updateListener.of((update) => {
          if (update.docChanged) formatSoon();
        }),
      ],
      WELCOME,
    ),
  });
  // Until djLint has loaded, the output's first line says how far it got.
  const loading = document.createElement("span");
  loading.className = "demo-loading";
  const setStatus = (text: string, error = false) => {
    status.textContent = loading.textContent = text;
    loading.classList.toggle("error", error);
  };
  setStatus(status.textContent!.trim());

  const outputElement = document.getElementById("djlint-output")!;
  const language = new Compartment();
  const label = new Compartment();
  const output = new EditorView({
    parent: outputElement,
    state: editorState([
      language.of(template),
      label.of(labelledBy("djlint-view-0")),
      EditorState.readOnly.of(true),
      placeholder(() => loading),
    ]),
  });

  const languages: Record<string, Extension> = {
    output: template,
    // The commands get long, so they wrap.
    cli: [StreamLanguage.define(shell), EditorView.lineWrapping],
    "pyproject.toml": StreamLanguage.define(toml),
    "djlint.toml": StreamLanguage.define(toml),
    ".djlintrc": StreamLanguage.define(json),
  };
  let view = "output";
  let formatted = "";
  function showOutput() {
    const config = getConfig();
    const text =
      view === "output"
        ? formatted
        : view === "cli"
          ? commands(config)
          : configFile(config, view as "pyproject.toml") || `# ${outputElement.dataset.defaults}`;
    output.dispatch({
      changes: { from: 0, to: output.state.doc.length, insert: text },
      effects: language.reconfigure(languages[view]),
    });
  }

  // After the output and its view exist: restoring formats the example.
  const restored = restore();
  addEventListener("hashchange", restore);

  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-view]")];
  for (const tab of tabs) {
    tab.addEventListener("click", () => {
      view = tab.dataset.view!;
      for (const other of tabs) other.setAttribute("aria-pressed", String(other === tab));
      output.dispatch({ effects: label.reconfigure(labelledBy(tab.id)) });
      showOutput();
    });
  }

  // Finding positions count characters from line 1 and column 0; CodeMirror
  // counts UTF-16 code units from the start of the document.
  function position(doc: Text, line: number, column: number) {
    if (line > doc.lines) return doc.length;
    const { from, text } = doc.line(line);
    let offset = 0;
    for (const [i, char] of [...text].entries()) {
      if (i === column) break;
      offset += char.length;
    }
    return from + offset;
  }

  type Finding = Record<"code" | "message", string> &
    Record<"line" | "column" | "end_line" | "end_column", number>;
  function showFindings(findings: Finding[] | null) {
    const doc = input.state.doc;
    const diagnostics: Diagnostic[] = (findings ?? []).map((finding) => {
      const from = position(doc, finding.line, finding.column);
      return {
        from,
        to: Math.max(from, position(doc, finding.end_line, finding.end_column)),
        severity: "warning",
        message: `${finding.code} ${finding.message}`,
      };
    });
    input.dispatch(setDiagnostics(input.state, diagnostics));
    problems.textContent = !findings
      ? ""
      : findings.length
        ? problems.dataset.count!.replace("{count}", String(findings.length))
        : problems.dataset.clean!;
    problems.dataset.state = findings?.length ? "messy" : "clean";
  }

  // The worker reports its progress as codes; the page holds their translations.
  const showError = () => setStatus(status.dataset.error!, true);
  worker.onerror = showError;
  const warningList = document.getElementById("djlint-warnings")!;
  const showWarnings = (warnings: string[]) => {
    warningList.replaceChildren(
      ...warnings.map((warning) => Object.assign(document.createElement("li"), { textContent: warning })),
    );
  };
  worker.onmessage = ({ data: { id, type, message, html, findings, warnings } }) => {
    if (type === "status" && message === "ready") {
      // Edits made while djLint loaded may have reached the worker before it
      // listened, so the current example goes again.
      setStatus("");
      loading.hidden = true;
      void restored.then(format);
    } else if (type === "status" && message === "error") {
      showError();
    } else if (type === "version") {
      document.getElementById("djlint-version")!.textContent = status.dataset
        .version!.replace("{python}", message.python)
        .replace("{djlint}", message.djlint);
    } else if ((type === "result" || type === "error") && id === sessionId) {
      formatted = type === "result" ? html : message;
      showWarnings(type === "result" ? warnings : []);
      if (view === "output") showOutput();
      if (input.state.doc === requested) showFindings(type === "result" ? findings : null);
    }
  };

  form.addEventListener("input", formatSoon);

  // The settings are open beside the editors and folded above them.
  const settings = document.querySelector<HTMLDetailsElement>(".demo-settings")!;
  matchMedia("(width >= 60rem)").addEventListener("change", ({ matches }) => {
    settings.open = matches;
  });

  // The "?" next to a field shows the option's description on hover or focus.
  // Screen readers get it through aria-describedby; this copy is for the eye.
  const hint = document.getElementById("djlint-hint")!;
  let hideTimer: ReturnType<typeof setTimeout> | undefined;
  const hideHint = () => {
    clearTimeout(hideTimer);
    hint.hidden = true;
  };
  // Long enough to cross the gap between the "?" and the hint.
  const hideHintSoon = () => {
    clearTimeout(hideTimer);
    hideTimer = setTimeout(hideHint, 300);
  };
  const hintLink = (target: EventTarget | null) =>
    target instanceof Element ? target.closest<HTMLAnchorElement>("a[aria-describedby]") : null;
  function showHint(link: HTMLAnchorElement) {
    clearTimeout(hideTimer);
    hint.innerHTML = document.getElementById(link.getAttribute("aria-describedby")!)!.innerHTML;
    hint.hidden = false;
    // Right of the settings, level with the "?", so it covers the editor and
    // never the next field; under or over it where the window is too narrow.
    const box = link.getBoundingClientRect();
    const beside = form.getBoundingClientRect().right + 12;
    const { offsetWidth: width, offsetHeight: height } = hint;
    if (beside + width <= innerWidth - 8) {
      hint.style.left = `${beside}px`;
      hint.style.top = `${Math.max(8, Math.min(box.top - 8, innerHeight - height - 8))}px`;
    } else {
      const fitsBelow = box.bottom + 6 + height <= innerHeight;
      hint.style.left = `${Math.max(8, Math.min(box.left - 8, innerWidth - width - 8))}px`;
      hint.style.top = `${fitsBelow ? box.bottom + 6 : box.top - 6 - height}px`;
    }
  }
  form.addEventListener("pointerover", ({ target, pointerType }) => {
    const link = hintLink(target);
    if (link && pointerType === "mouse") showHint(link);
  });
  form.addEventListener("focusin", ({ target }) => {
    const link = hintLink(target);
    if (link) showHint(link);
  });
  // The pointer can move onto the hint without it going away.
  form.addEventListener("pointerout", ({ target }) => {
    if (hintLink(target)) hideHintSoon();
  });
  hint.addEventListener("pointerenter", () => clearTimeout(hideTimer));
  hint.addEventListener("pointerleave", hideHintSoon);
  form.addEventListener("focusout", hideHint);
  settings.addEventListener("scroll", hideHint);
  addEventListener("keydown", ({ key }) => {
    if (key === "Escape") hideHint();
  });

  // "Copied" goes to a status region: a changed label on the focused button is
  // not reliably announced. Safari only lets the click itself write to the
  // clipboard, so the text goes in as a promise.
  function copyButton(id: string, text: () => string | Promise<string>) {
    const button = document.getElementById(id)!;
    const announce = document.getElementById(`${id}-status`)!;
    const idle = button.textContent!.trim();
    let reset: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener("click", async () => {
      const value = Promise.resolve(text());
      const blob = value.then((done) => new Blob([done], { type: "text/plain" }));
      try {
        await navigator.clipboard.write([new ClipboardItem({ "text/plain": blob })]);
      } catch {
        // A browser without promises in ClipboardItem gets the finished text.
        try {
          await navigator.clipboard.writeText(await value);
        } catch {
          return; // Clipboard access was denied.
        }
      }
      clearTimeout(reset);
      button.textContent = announce.textContent = button.dataset.copied!;
      reset = setTimeout(() => {
        button.textContent = idle;
        announce.textContent = "";
      }, 1500);
    });
  }
  // The link is made from the editor as it is now, not from the address,
  // which waits for the debounce.
  copyButton("djlint-share", () => exampleUrl(input.state.doc.toString(), getConfig()));
  copyButton("djlint-copy", () => output.state.doc.toString());
</script>

<style>
  /* The splash template caps content at reading width; the editors need the
     whole page column, which custom.css already caps for wide screens. */
  :global(main:has(.demo) .sl-container) {
    max-width: none;
  }
  .demo-workspace {
    display: grid;
    grid-template-columns: 17rem 1fr;
    gap: 1.5rem;
  }
  summary {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    font-weight: 600;
    cursor: pointer;
  }
  form,
  fieldset {
    display: flex;
    flex-direction: column;
    font-size: var(--sl-text-sm);
  }
  form {
    gap: 1.5rem;
  }
  fieldset {
    gap: 0.6rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  legend {
    margin-block-end: 0.6rem;
    padding: 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  details[open] form {
    margin-block-start: 0.75rem;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin: 0;
  }
  label.checkbox {
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
  }
  label > span {
    color: var(--sl-color-white);
  }
  /* A ringed "?" after each flag: the ring sets the link apart from the text. */
  form a {
    display: inline-grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    color: var(--sl-color-gray-3);
    font-size: 0.7rem;
    line-height: 1;
    text-decoration: none;
    vertical-align: middle;
  }
  form a:hover {
    color: var(--sl-color-white);
  }
  input:not([type="checkbox"]),
