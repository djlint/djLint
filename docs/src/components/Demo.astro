---
import { starlightRoute } from "../utils/route";

const { t } = Astro.locals;
// llms.txt renders pages without a route, and the demo has nothing for it.
const route = starlightRoute(Astro.locals);
const prefix = route?.locale ? `/${route.locale}` : "";

// The formatter's options, named as in its Python API and shown as their
// command line flags, in the order of `djlint --help`. A field with options is
// a menu, one with a placeholder takes a value (a number when the placeholder
// is one), any other is a switch. `anchor` is the option's section on the
// configuration page, where it differs from its name.
const fields: { name: string; placeholder?: string; options?: string[][]; anchor?: string }[] = [
  {
    name: "profile",
    options: [
      ["", "none"],
      ["html", "html"],
      ["django", "django"],
      ["jinja", "jinja"],
      ["nunjucks", "nunjucks (and twig)"],
      ["handlebars", "handlebars (and mustache)"],
      ["liquid", "liquid"],
      ["golang", "golang (go templates)"],
      ["angular", "angular"],
      ["tera", "tera"],
      ["askama", "askama"],
      ["mako", "mako"],
    ],
  },
  { name: "indent", placeholder: "4" },
  { name: "max_line_length", placeholder: "120" },
  { name: "max_attribute_length", placeholder: "70" },
  { name: "single_attribute_per_line" },
  { name: "line_break_after_multiline_tag" },
  { name: "no_indent_inner_html" },
  { name: "keep_br_inline" },
  { name: "custom_blocks", placeholder: "toc,example" },
  { name: "custom_html", placeholder: "mjml,simple-greeting,mj-\\w+" },
  { name: "ignore_blocks", placeholder: "raw,example" },
  { name: "blank_line_after_tag", placeholder: "load,extends,include" },
  { name: "blank_line_before_tag", placeholder: "load,extends,include" },
  { name: "max_blank_lines", placeholder: "0" },
  { name: "preserve_blank_lines" },
  { name: "preserve_leading_space" },
  { name: "no_line_after_yaml" },
  { name: "close_void_tags" },
  { name: "ignore_case" },
  { name: "sort_attributes" },
  { name: "sort_load_tags" },
  { name: "name_endblocks" },
  { name: "quote_style", options: [["", "double"], ["single", "single"]] },
  { name: "no_entity_formatting" },
  { name: "no_function_formatting" },
  { name: "no_set_formatting" },
  { name: "preserve_class_newlines" },
  { name: "format_attribute_template_tags" },
  { name: "format_css" },
  { name: "indent_css", placeholder: "4", anchor: "format-css" },
  { name: "format_js" },
  { name: "indent_js", placeholder: "4", anchor: "format-js" },
  { name: "format_attribute_js_json" },
  { name: "format_attribute_js_json_pattern", placeholder: "^(on[a-z]+|x-[a-z-]+)$" },
  { name: "format_attribute_js_json_min_props", placeholder: "2" },
];

const kebab = (name: string) => name.replaceAll("_", "-");
const help = (anchor: string) => `${prefix}/docs/configuration/#${anchor}`;
// What a "?" link says to a screen reader: which option's documentation it opens.
// The fields get their names from aria-label, so the link doesn't join them.
const helpLabel = (flag: string) => `${t("djlint.configuration")}: ${flag}`;
---

{
  route && (
    <div class="demo not-content">
      <p>{t("djlint.demo_description")} <small id="djlint-version"></small></p>

      <div class="demo-workspace">
        <details class="demo-settings" open>
          <summary>{t("djlint.demo_options")}</summary>
          <form id="djlint-settings">
            {
              fields.map(({ name, placeholder, options, anchor }) => {
                const flag = `--${kebab(name)}`;
                const toggle = !placeholder && !options;
                return (
                  <label class:list={{ checkbox: toggle }}>
                    {toggle && <input name={name} type="checkbox" aria-label={flag} />}
                    <span>
                      <span class="flag">{flag}</span>{" "}
                      <a href={help(anchor ?? kebab(name))} target="_blank" aria-label={helpLabel(flag)}>
                        ?
                      </a>
                    </span>
                    {options && (
                      <select name={name} aria-label={flag}>
                        {options.map(([value, text]) => <option value={value}>{text}</option>)}
                      </select>
                    )}
                    {placeholder && (
                      <input
                        name={name}
                        type={/^\d+$/.test(placeholder) ? "number" : "text"}
                        min="0"
                        placeholder={placeholder}
                        aria-label={flag}
                      />
                    )}
                  </label>
                );
              })
            }
          </form>
        </details>
        {/* Side by side the settings stay open; above the editors they start closed. */}
        <script is:inline>
          document.currentScript.previousElementSibling.open = matchMedia("(width >= 60rem)").matches;
        </script>
        <div class="demo-editors">
          <section>
            <div class="demo-head">
              <span id="djlint-input-label">input.html</span>
              <button type="button" id="djlint-share" data-copied={t("djlint.copied")}>
                {t("djlint.demo_copy_link")}
              </button>
              <span class="sr-only" role="status" id="djlint-share-status"></span>
            </div>
            <div class="demo-editor" id="djlint-input"></div>
          </section>
          <section>
            <div class="demo-head">
              <span id="djlint-output-label">
                <span class="prompt" aria-hidden="true">$</span>{" "}
                <span id="djlint-command">djlint input.html --reformat</span>
              </span>
              <span
                id="djlint-status"
                role="status"
                data-installing={t("djlint.demo_installing")}
                data-version={t("djlint.demo_version")}
                data-error={t("djlint.demo_error")}
              >
                {t("djlint.demo_loading")}
              </span>
            </div>
            <div class="demo-editor" id="djlint-output"></div>
          </section>
        </div>
      </div>
    </div>
  )
}

<script>
  import { jinja } from "@codemirror/lang-jinja";
  import { EditorState } from "@codemirror/state";
  import { basicSetup, EditorView } from "codemirror";
  import { decodeState, encodeState } from "../scripts/demo-state";
  import { djlintEditorTheme } from "../scripts/editor-theme.js";

  const WELCOME = "<div>\n    <p>Welcome to djLint online!</p>\n</div>";
  const status = document.getElementById("djlint-status")!;
  const form = document.querySelector<HTMLFormElement>("#djlint-settings")!;
  const worker = new Worker("/static/js/worker.js", { type: "module" });
  let sessionId = 0;

  const editorState = (label: string, extensions: object[], doc = "") =>
    EditorState.create({
      doc,
      extensions: [
        basicSetup,
        // HTML with the {{ }}, {% %} and {# #} tags of Django, Jinja, Nunjucks and Twig.
        jinja(),
        djlintEditorTheme,
        EditorView.contentAttributes.of({ "aria-labelledby": label }),
        ...extensions,
      ],
    });

  function getConfig() {
    const config: Record<string, string | boolean> = {};
    for (const field of form.querySelectorAll<HTMLInputElement>("[name]")) {
      const value = field.type === "checkbox" ? field.checked : field.value;
      if (value) config[field.name] = value;
    }
    return config;
  }

  function setConfig(config: Record<string, string | boolean>) {
    for (const field of form.querySelectorAll<HTMLInputElement>("[name]")) {
      const value = config[field.name];
      if (field.type === "checkbox") field.checked = value === true;
      else field.value = typeof value === "string" ? value : "";
    }
  }

  // The address always holds the current example, so it can be shared as is.
  // The welcome example with no settings keeps the plain address.
  async function exampleUrl(html: string, config: Record<string, string | boolean>) {
    const plain = html === WELCOME && Object.keys(config).length === 0;
    const hash = plain ? "" : `#${await encodeState({ html, config })}`;
    return `${location.origin}${location.pathname}${hash}`;
  }

  async function saveState(html: string, config: Record<string, string | boolean>, id: number) {
    const url = await exampleUrl(html, config);
    if (id === sessionId) history.replaceState(null, "", url);
  }

  // The output's header is the command that gives the same result.
  const command = document.getElementById("djlint-command")!;
  const shellWord = (text: string) =>
    /^[\w,.+-]+$/.test(text) ? text : `'${text.replaceAll("'", "'\\''")}'`;

  function format() {
    sessionId += 1;
    const config = getConfig();
    const html = input.state.doc.toString();
    worker.postMessage({ config, html, id: sessionId });
    void saveState(html, config, sessionId);
    const flags = Object.entries(config).map(([name, value]) => {
      const flag = `--${name.replaceAll("_", "-")}`;
      return value === true ? flag : `${flag}=${shellWord(value)}`;
    });
    command.textContent = ["djlint input.html --reformat", ...flags].join(" ");
  }

  // A later restore wins over an earlier one that is still decoding.
  let restoreId = 0;
  async function restore() {
    const id = ++restoreId;
    const hash = location.hash.slice(1);
    // No hash is the welcome example (going back to the plain address); a hash
    // that doesn't decode, such as #_top from the skip link, changes nothing.
    const state = hash ? await decodeState(hash) : { html: WELCOME, config: {} };
    if (!state || id !== restoreId) return;
    setConfig(state.config);
    if (state.html !== input.state.doc.toString()) {
      input.dispatch({ changes: { from: 0, to: input.state.doc.length, insert: state.html } });
    } else {
      format();
    }
  }

  // Typing in the editor or a field formats once the typing pauses.
  let timer: ReturnType<typeof setTimeout>;
  const formatSoon = () => {
    clearTimeout(timer);
    timer = setTimeout(format, 100);
  };
  const input = new EditorView({
    parent: document.getElementById("djlint-input")!,
    state: editorState(
      "djlint-input-label",
      [
        EditorView.updateListener.of((update) => {
          if (update.docChanged) formatSoon();
        }),
      ],
      WELCOME,
    ),
  });
  const restored = restore();
  addEventListener("hashchange", restore);
  const output = new EditorView({
    parent: document.getElementById("djlint-output")!,
    state: editorState("djlint-output-label", [EditorState.readOnly.of(true)]),
  });

  // The worker reports its progress as codes; the page holds their translations.
  const showError = () => {
    status.textContent = status.dataset.error!;
  };
  worker.onerror = showError;
  worker.onmessage = ({ data: { id, type, message } }) => {
    if (type === "status" && message === "ready") {
      // Edits made while djLint loaded may have reached the worker before it
      // listened, so the current example goes again.
      status.hidden = true;
      void restored.then(format);
    } else if (type === "status" && message === "error") {
      showError();
    } else if (type === "status" && message === "installing") {
      status.textContent = status.dataset.installing!;
    } else if (type === "version") {
      document.getElementById("djlint-version")!.textContent = status.dataset
        .version!.replace("{python}", message.python)
        .replace("{djlint}", message.djlint);
    } else if ((type === "html" || type === "error") && id === sessionId) {
      output.dispatch({ changes: { from: 0, to: output.state.doc.length, insert: message } });
    }
  };

  form.addEventListener("input", formatSoon);

  // The settings are open beside the editors and folded above them.
  const settings = document.querySelector<HTMLDetailsElement>(".demo-settings")!;
  matchMedia("(width >= 60rem)").addEventListener("change", ({ matches }) => {
    settings.open = matches;
  });

  // "Copied" goes to a status region: a changed label on the focused button is
  // not reliably announced.
  const share = document.querySelector<HTMLButtonElement>("#djlint-share")!;
  const shareStatus = document.getElementById("djlint-share-status")!;
  const shareLabel = share.textContent!.trim();
  let shareTimer: ReturnType<typeof setTimeout> | undefined;
  share.addEventListener("click", async () => {
    // The link is made from the editor as it is now, not from the address,
    // which waits for the debounce. Safari only lets the click itself write
    // to the clipboard, so the link goes in as a promise.
    const url = exampleUrl(input.state.doc.toString(), getConfig());
    const blob = url.then((text) => new Blob([text], { type: "text/plain" }));
    try {
      await navigator.clipboard.write([new ClipboardItem({ "text/plain": blob })]);
    } catch {
      // A browser without promises in ClipboardItem gets the finished text.
      try {
        await navigator.clipboard.writeText(await url);
      } catch {
        return; // Clipboard access was denied; the address bar has the link too.
      }
    }
    clearTimeout(shareTimer);
    share.textContent = shareStatus.textContent = share.dataset.copied!;
    shareTimer = setTimeout(() => {
      share.textContent = shareLabel;
      shareStatus.textContent = "";
    }, 1500);
  });
</script>

<style>
  /* The splash template caps content at reading width; the editors need the
     whole page column, which custom.css already caps for wide screens. */
  :global(main:has(.demo) .sl-container) {
    max-width: none;
  }
  .demo-workspace {
    display: grid;
    grid-template-columns: 17rem 1fr;
    gap: 1.5rem;
  }
  summary {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    font-weight: 600;
    cursor: pointer;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: var(--sl-text-sm);
  }
  details[open] form {
    margin-block-start: 0.75rem;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin: 0;
  }
  label.checkbox {
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
  }
  .flag {
    color: var(--sl-color-white);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    overflow-wrap: anywhere;
  }
  /* A ringed "?" after each flag: the ring sets the link apart from the text. */
  form a {
    display: inline-grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    color: var(--sl-color-gray-3);
    font-size: 0.7rem;
    line-height: 1;
    text-decoration: none;
    vertical-align: middle;
  }
  form a:hover {
    color: var(--sl-color-white);
  }
  input:not([type="checkbox"]),
  select {
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font: inherit;
  }
  /* The placeholders are the defaults, readable but quieter than a value. */
  input::placeholder {
    color: var(--sl-color-gray-3);
  }
  /* The heads share a row, so the editors line up when the command wraps. */
  .demo-editors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto minmax(0, 1fr);
    gap: 0 1rem;
    margin: 0;
  }
  .demo-editors section {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    margin: 0;
    border: 1px solid var(--dj-code-line);
    border-radius: 0.75rem;
    overflow: hidden;
    background: var(--dj-code-bg);
    /* The editors are dark in both themes, and so are their scrollbars. */
    color-scheme: dark;
  }
  .demo-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0;
    padding: 0.4rem 1rem;
    border-bottom: 1px solid var(--dj-code-line);
    color: #a9b1d6;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
  }
  .demo-head button {
    margin-inline-start: auto;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--dj-code-line);
    border-radius: 0.375rem;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .demo-head button:hover {
    border-color: #8a91b8;
    color: #c0caf5;
  }
  .demo-head .prompt {
    color: var(--dj-squiggle);
  }
  #djlint-status {
    margin-inline-start: auto;
    white-space: nowrap;
  }
  .demo-editor {
    min-height: 20rem;
    margin: 0;
  }
  /* Side by side, the demo fills the window under the header: the editors and
     the settings scroll inside it, the page doesn't. Every wrapper between the
     page and the demo passes the height down. */
  @media (width >= 60rem) {
    :global(.page :has(.demo)),
    .demo {
      display: flex;
      flex: 1 1 0;
      flex-direction: column;
      inline-size: 100%;
      min-height: 0;
    }
    /* A window too short for this lets the page scroll after all. */
    .demo-workspace {
      flex: 1 1 0;
      grid-template-rows: minmax(0, 1fr);
      min-height: 22rem;
    }
    .demo-settings {
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    summary {
      display: none;
    }
    details[open] form {
      margin: 0;
    }
    .demo-editor {
      min-height: 0;
    }
  }
  @media (width < 60rem) {
    .demo-workspace,
    .demo-editors {
      grid-template-columns: 1fr;
    }
    .demo-editors {
      grid-template-rows: none;
      gap: 1rem;
    }
    .demo-editor {
      height: 40dvh;
    }
  }
</style>
