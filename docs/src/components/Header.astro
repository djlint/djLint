---
// Starlight's header with the main docs sections linked across the top. Pages
// without a sidebar (home, demo) have no mobile menu of Starlight's, so on
// narrow screens they get a menu button that opens the same sidebar.
import { Icon } from "@astrojs/starlight/components";
import LanguageSelect from "@astrojs/starlight/components/LanguageSelect.astro";
import Search from "@astrojs/starlight/components/Search.astro";
import Sidebar from "@astrojs/starlight/components/Sidebar.astro";
import SiteTitle from "@astrojs/starlight/components/SiteTitle.astro";
import SocialIcons from "@astrojs/starlight/components/SocialIcons.astro";
import ThemeSelect from "@astrojs/starlight/components/ThemeSelect.astro";
import { pageId } from "../utils/route";

const { t } = Astro.locals;
const route = Astro.locals.starlightRoute;
const prefix = route.locale ? `${route.locale}/` : "";
const page = pageId(route);

const links = [
  ["docs/getting-started", "djlint.getting_started"],
  ["docs/formatter", "djlint.formatter"],
  ["docs/linter", "djlint.linter"],
  ["docs/configuration", "djlint.configuration"],
  ["docs/integrations", "djlint.integrations"],
  ["demo", "djlint.try_online"],
] as const;
---

<div class="header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
  </div>
  <nav class="top-nav print:hidden" aria-label={t("djlint.sections")}>
    {
      links.map(([slug, key]) => (
        <a href={`/${prefix}${slug}/`} aria-current={page === slug ? "page" : undefined}>
          {t(key)}
        </a>
      ))
    }
  </nav>
  <div class="search sl-flex print:hidden">
    <Search />
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
  {
    !route.hasSidebar && (
      <>
        <button class="menu-button print:hidden" popovertarget="dj-menu">
          <Icon name="bars" class="open-menu" />
          <Icon name="close" class="close-menu" />
          <span class="sr-only">{t("menuButton.accessibleLabel")}</span>
        </button>
        {/* The docs pages' own sidebar, so the menu is the same on every page. */}
        <div id="dj-menu" class="menu" popover>
          <div class="sidebar-content">
            <Sidebar />
          </div>
        </div>
      </>
    )
  }
</div>

<style>
  .header {
    display: flex;
    gap: var(--sl-nav-gap);
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  .title-wrapper {
    flex-shrink: 0;
    min-width: 0;
    padding: 0.25rem;
    margin: -0.25rem;
    overflow: clip;
  }

  .top-nav {
    display: none;
    gap: 1.5rem;
    padding-inline-start: 1.5rem;
    margin-inline-end: auto;
  }

  .top-nav a {
    font-size: var(--sl-text-sm);
    font-weight: 500;
    color: var(--sl-color-gray-2);
    white-space: nowrap;
    text-decoration: none;
  }

  .top-nav a:hover,
  .top-nav a[aria-current="page"] {
    color: var(--sl-color-white);
  }

  /* The current section is squiggled, as the current page in the sidebar is. */
  .top-nav a[aria-current="page"] {
    padding-block-end: 0.4em;
    margin-block-end: -0.4em;
    background: var(--dj-current-wave);
  }

  .right-group,
  .social-icons {
    flex-shrink: 0;
    gap: 1rem;
    align-items: center;
  }

  /* Starlight sizes these for its own font; "Светлая" and "Русский" need more. */
  .right-group :global(label) {
    --sl-select-width: 7.5em !important;
  }

  .social-icons::after {
    height: 2rem;
    content: "";
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }

  /* Without the section links, the search sits by the controls on the right. */
  @media (width <= 89.99rem) {
    .search {
      margin-inline-start: auto;
    }
  }

  /* The same round button as Starlight's sidebar toggle on the other pages. */
  .menu-button {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: var(--sl-menu-button-size);
    height: var(--sl-menu-button-size);
    padding: 0.5rem;
    color: var(--sl-color-black);
    cursor: pointer;
    background: var(--sl-color-white);
    border: 0;
    border-radius: 50%;
    box-shadow: var(--sl-shadow-md);
  }

  :global([data-theme="light"]) .menu-button {
    color: var(--sl-color-white);
    background: var(--sl-color-black);
  }

  .menu-button:has(~ :popover-open) {
    background: var(--sl-color-gray-2);
    box-shadow: none;
  }

  :global([data-theme="light"]) .menu-button:has(~ :popover-open) {
    background: var(--sl-color-gray-5);
  }

  .menu-button:has(~ :popover-open) :global(.open-menu),
  .menu-button:not(:has(~ :popover-open)) :global(.close-menu) {
    display: none;
  }

  /* On a phone, a pane over the whole page below the header, as Starlight's
     sidebar is on the docs pages. */
  .menu {
    inset: var(--sl-nav-height) 0 0;
    width: 100%;
    height: auto;
    padding: 1rem var(--sl-sidebar-pad-x) 0;
    overflow-y: auto;
    color: var(--sl-color-white);
    background: var(--sl-color-black);
    border: 0;
  }

  .sidebar-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  :global(body:has(#dj-menu:popover-open)) {
    overflow: hidden;
  }

  /* Wider, where the header shows the preferences itself, a panel under the
     button is enough. */
  @media (width >= 50rem) {
    .menu {
      inset: var(--sl-nav-height) 0 auto auto;
      width: 20rem;
      max-height: calc(100dvh - var(--sl-nav-height));
      padding: 1rem var(--sl-nav-pad-x);
      border-inline-start: 1px solid var(--sl-color-gray-6);
      border-bottom: 1px solid var(--sl-color-gray-6);
      border-end-start-radius: 0.75rem;
      box-shadow: var(--sl-shadow-md);
    }

    :global(body:has(#dj-menu:popover-open)) {
      overflow: auto;
    }
  }

  /* The longest translations of the section links need the full 90rem page. */
  @media (width >= 90rem) {
    .top-nav {
      display: flex;
    }

    .menu-button,
    .menu {
      display: none;
    }
  }
</style>
