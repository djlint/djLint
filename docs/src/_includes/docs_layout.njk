---
layout: layout.njk
---
{% set docsNav = [
  ["/docs/getting-started/", "getting_started"],
  ["/docs/formatter/", "formatter"],
  ["/docs/linter/", "linter"],
  ["/docs/ignoring-code/", "ignoring_code"],
  ["/docs/configuration/", "configuration"],
  ["/docs/integrations/", "integrations"],
  ["/docs/language-server/", "language_server"],
  ["/docs/python-api/", "python_api"],
  ["/docs/best-practices/", "best_practices"],
  ["/docs/changelog/", "changelog"]
] %}
<div class="container">
  <div class="docs-layout">
    <aside class="docs-sidebar">
      <nav class="docs-sidebar-inner" aria-label="{{ "documentation" | i18n }}">
        <p class="docs-sidebar-label">{{ "documentation" | i18n }}</p>
        <ul>
          {% for item in docsNav %}
          <li><a{% if (page.url | baseUrl) == item[0] %} aria-current="page"{% endif %} href="{{ "lang_code_url" | i18n }}{{ item[0] }}">{{ item[1] | i18n }}</a></li>
          {% endfor %}
        </ul>
      </nav>
    </aside>
    <article class="docs-content">
      {{ content | safe }}
      {% include "src/_includes/page_meta.njk" %}
    </article>
    <aside class="docs-toc" hidden>
      <nav class="docs-toc-inner" aria-label="{{ "on_this_page" | i18n }}">
        <ul></ul>
      </nav>
    </aside>
  </div>
</div>
<script>
// Build the "on this page" list from the article's second-level headings
// and mark the section the reader has scrolled to.
(function () {
  var toc = document.querySelector('.docs-toc');
  var headings = document.querySelectorAll('.docs-content h2[id]');
  if (headings.length < 2) return;
  var list = toc.querySelector('ul');
  var links = {};
  headings.forEach(function (h) {
    var a = document.createElement('a');
    a.href = '#' + h.id;
    a.textContent = h.textContent.replace(/^\s*#\s*/, '');
    var li = document.createElement('li');
    li.appendChild(a);
    list.appendChild(li);
    links[h.id] = a;
  });
  toc.hidden = false;
  var current;
  var ticking = false;
  function update() {
    ticking = false;
    var line = document.querySelector('.djlint-nav').offsetHeight + 24;
    var active = headings[0];
    headings.forEach(function (h) {
      if (h.getBoundingClientRect().top <= line) active = h;
    });
    var link = links[active.id];
    if (link === current) return;
    if (current) current.removeAttribute('aria-current');
    link.setAttribute('aria-current', 'true');
    current = link;
  }
  window.addEventListener('scroll', function () {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }, { passive: true });
  update();
})();
</script>
