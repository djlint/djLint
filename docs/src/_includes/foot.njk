<footer class="footer">
    <div class="container">
        <div class="columns">
            <div class="column is-one-third">
                <figure class="image logo">
                    <picture><source srcset="/static/img/logo-wide-dark.svg" media="(prefers-color-scheme: dark)"><img src="/static/img/logo-wide-light.svg" alt="djLint" width="443" height="168"></picture>
                </figure>
                <p class="my-4">
                    {{ "description" | i18n }}
                </p>
            </div>
            <div class="column"></div>
            <div class="column">
                <p class="copyright has-text-right">
                    djLint | ©{{ page.date | year }}
                </p>
                <p class="has-text-grey-dark has-text-right mt-2">
                    <small>{{ "footer_credits" | i18n | safe }}</small>
                </p>
            </div>
        </div>
    </div>
</footer>
