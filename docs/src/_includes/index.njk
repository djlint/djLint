---
layout: layout.njk
date: Last Modified

---
{% block body %}
<section class="home-hero">
  <div class="container">
    <h1 class="hero-mark">{% include "src/_includes/hero-logo.svg" %}</h1>
    <p class="hero-title">{{ "index_title" | i18n }}</p>
    <p class="story">{{ "index_description" | i18n | safe }}</p>
    <div class="install">
      {% for cmd in ["uv tool install djlint", "pip install djlint"] %}
      <div class="install-cmd">
        <code><span class="install-prompt" aria-hidden="true">$</span>{{ cmd }}</code>
        <button class="copy-button" type="button" data-copy="{{ cmd }}" aria-label="Copy “{{ cmd }}”"><i class="fa-regular fa-copy"></i></button>
      </div>
      {% endfor %}
    </div>
    <div class="buttons is-centered">
      <a class="button is-brand is-medium" href="{{ "lang_code_url" | i18n }}/docs/getting-started/">{{ "getting_started" | i18n }}</a>
      <a class="button is-medium" href="{{ "lang_code_url" | i18n }}/demo/">{{ "try_online" | i18n }}</a>
    </div>
  </div>
</section>

<section class="home-section">
  <div class="container">
<h2 class="title is-2 home-heading">{{ "index_fav_lang" | i18n }}</h2>
<ul class="lang-grid">
{% for lang in templateLanguages %}
   <li>
      <a class="lang-tile" style="--brand: {{ lang.brand }}; --mark: url(/static/img/logos/{{ lang.logo }}); --logo-scale: {{ lang.logoScale or 1 }}" href="{{ "lang_code_url" | i18n }}/docs/languages/{{ lang.slug }}/">
         <span class="lang-mark"></span>
         <span class="lang-name">{{ lang.name }}</span>
      </a>
   </li>
{% endfor %}
</ul>
<script>
// Let the hover light follow the pointer across a tile.
document.querySelector('.lang-grid').addEventListener('pointermove', function (e) {
  var tile = e.target.closest('.lang-tile');
  if (!tile) return;
  var box = tile.getBoundingClientRect();
  tile.style.setProperty('--x', e.clientX - box.left + 'px');
  tile.style.setProperty('--y', e.clientY - box.top + 'px');
});
</script>
  </div>
</section>

<section class="home-section">
  <div class="container">
<h2 class="title is-2 home-heading">{{ "index_before_after" | i18n }}</h2>
   <div class="compare">
      <div class="compare-pane">
         <div class="compare-head">messy.html</div>

{% highlight "html" %}{% raw %}
{% block content %}
<SECTION class="posts">


<h2>Latest posts</h2>
{%if posts%}
<ul>
{% for post in posts %}
<li>
<a href="{% url 'post' post.slug %}" class="post-link {%if post.featured%}is-featured{%endif%}" data-analytics-id="post-{{post.id}}" aria-label="Read {{post.title}}">{{post.title|title}}</a>
</li>
{% endfor %}
</ul>
{%else%}
<p>No posts yet.</p>
{%endif%}
</SECTION>
{% endblock %}
{% endraw %}{% endhighlight %}

      </div>
      <div class="compare-pane">
         <div class="compare-head"><span class="compare-prompt">$</span> djlint messy.html --reformat --single-attribute-per-line</div>

{% highlight "html" %}{% raw %}
{% block content %}
    <section class="posts">
        <h2>Latest posts</h2>
        {% if posts %}
            <ul>
                {% for post in posts %}
                    <li>
                        <a
                            href="{% url 'post' post.slug %}"
                            class="post-link {% if post.featured %}is-featured{% endif %}"
                            data-analytics-id="post-{{ post.id }}"
                            aria-label="Read {{ post.title }}"
                        >{{ post.title|title }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p>No posts yet.</p>
        {% endif %}
    </section>
{% endblock %}
{% endraw %}{% endhighlight %}

      </div>
   </div>
    <div class="has-text-centered mt-5">
      <a class="button is-brand is-medium" href="{{ "lang_code_url" | i18n }}/demo/">{{ "try_online" | i18n }}</a>
    </div>
  </div>
</section>

<section class="home-section">
  <div class="container">
    <div class="home-card badge-card">
      <div>
        <h2 class="title is-3">{{ "index_show_format" | i18n }}</h2>
        <p class="mb-3">{{ "index_looks_like" | i18n }}</p>
        <img class="badge-preview" width="120" height="20" src="https://img.shields.io/badge/html%20style-djLint-blue.svg" alt="html style: djLint" />
      </div>
      <div class="badge-code">
        <p class="mb-2">{{ "index_add_badge" | i18n }}:</p>
        <div class="tabs is-small mb-0">
          <ul>
            <li class="is-active"><a tab="badge-md-tab">readme.md</a></li>
            <li><a tab="badge-rst-tab">readme.rst</a></li>
          </ul>
        </div>
        <div class="tab-container mb-0">
          <div class="tab is-active" id="badge-md-tab">
{% highlight "md" %}
[![Code style: djLint](https://img.shields.io/badge/html%20style-djLint-blue.svg)](https://github.com/djlint/djlint)
{% endhighlight %}
          </div>
          <div class="tab" id="badge-rst-tab">
{% highlight "md" %}
.. image:: https://img.shields.io/badge/html%20style-djLint-blue.svg
   :target: https://github.com/djlint/djlint
{% endhighlight %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="home-section">
  <div class="container">
    <div class="home-card contribute-card">
      <div>
        <h2 class="title is-3">{{ "contributing" | i18n }}</h2>
        <p>{{ "contributing_message" | i18n | safe }}</p>
      </div>
      <a class="button is-medium" href="https://github.com/djlint/djlint" target="_blank" rel="noopener"><span class="icon"><i class="fab fa-github"></i></span><span>GitHub</span></a>
    </div>
  </div>
</section>
{% include 'src/_includes/tabs_script.njk' %}

{% endblock body %}
