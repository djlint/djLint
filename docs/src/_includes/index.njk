---
layout: layout.njk
date: Last Modified

---
{% block body %}
<div class="section">
     <div class="container has-text-centered">
                 <h1 class="hero-logo mt-5 mb-6"><picture><source srcset="/static/img/logo-wide-dark.svg" media="(prefers-color-scheme: dark)"><img src="/static/img/logo-wide-light.svg" alt="djLint" width="443" height="168"></picture></h1>

                 <h2 class="title is-2">
                     {{ "index_title" |i18n }}</h2>

<p class="story my-5 has-text-left">{{ "index_description" | i18n | safe }}</p>

<div class="mb-4"><code class="install-chip">uv tool install djlint</code> <code class="install-chip">pip install djlint</code></div>

<div class="buttons is-centered mb-6">
   <a class="button is-info is-medium" href="{{ "lang_code_url" | i18n }}/docs/getting-started/">{{ "getting_started" | i18n }}</a>
   <a class="button is-medium" href="{{ "lang_code_url" | i18n }}/demo/">{{ "try_online" | i18n }}</a>
</div>

<h2 class="title is-2 has-text-centered mb-5">{{ "index_fav_lang" | i18n }}</h2>
<ul class="lang-grid">
{% for lang in templateLanguages %}
   <li>
      <a class="lang-tile" style="--brand: {{ lang.brand }}; --mark: url(/static/img/logos/{{ lang.logo }}); --logo-scale: {{ lang.logoScale or 1 }}" href="{{ "lang_code_url" | i18n }}/docs/languages/{{ lang.slug }}/">
         <span class="lang-mark"></span>
         <span class="lang-name">{{ lang.name }}</span>
      </a>
   </li>
{% endfor %}
</ul>
<script>
// Let the hover light follow the pointer across a tile.
document.querySelector('.lang-grid').addEventListener('pointermove', function (e) {
  var tile = e.target.closest('.lang-tile');
  if (!tile) return;
  var box = tile.getBoundingClientRect();
  tile.style.setProperty('--x', e.clientX - box.left + 'px');
  tile.style.setProperty('--y', e.clientY - box.top + 'px');
});
</script>

                  </div>
 </div>

<div class="container has-text-centered">
<h2 class="title is-2">{{ "index_before_after" | i18n }}</h2>
</div>

<div class="container">
   <div class="columns">
      <div class="column is-half">
         <h3 class="title is-5"><code>messy.html</code></h3>

{% highlight "html" %}{% raw %}
{% block content %}
<SECTION class="posts">


<h2>Latest posts</h2>
{%if posts%}
<ul>
{% for post in posts %}
<li>
<a href="{% url 'post' post.slug %}" class="post-link {%if post.featured%}is-featured{%endif%}" data-analytics-id="post-{{post.id}}" aria-label="Read {{post.title}}">{{post.title|title}}</a>
</li>
{% endfor %}
</ul>
{%else%}
<p>No posts yet.</p>
{%endif%}
</SECTION>
{% endblock %}
{% endraw %}{% endhighlight %}

      </div>
      <div class="column is-half">
         <h3 class="title is-5"><code>djlint messy.html --reformat --single-attribute-per-line</code></h3>

{% highlight "html" %}{% raw %}
{% block content %}
    <section class="posts">
        <h2>Latest posts</h2>
        {% if posts %}
            <ul>
                {% for post in posts %}
                    <li>
                        <a
                            href="{% url 'post' post.slug %}"
                            class="post-link {% if post.featured %}is-featured{% endif %}"
                            data-analytics-id="post-{{ post.id }}"
                            aria-label="Read {{ post.title }}"
                        >{{ post.title|title }}</a>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p>No posts yet.</p>
        {% endif %}
    </section>
{% endblock %}
{% endraw %}{% endhighlight %}

      </div>
   </div>
   <div class="has-text-centered mt-4">
      <a class="button is-info is-medium" href="{{ "lang_code_url" | i18n }}/demo/">{{ "try_online" | i18n }}</a>
   </div>
</div>

<div class="container has-text-centered">
<h2 class="title is-2 mt-5">{{ "index_show_format" | i18n }}</h2>
</div>
<div class="container">


{{ "index_add_badge" | i18n }} <code>readme.md</code>:

{% highlight "md" %}
[![Code style: djLint](https://img.shields.io/badge/html%20style-djLint-blue.svg)](https://github.com/djlint/djlint)
{% endhighlight %}

{{ "index_add_badge" | i18n }} <code>readme.rst</code>:

{% highlight "md" %}

   .. image:: https://img.shields.io/badge/html%20style-djLint-blue.svg
      :target: https://github.com/djlint/djlint
{% endhighlight %}

<p>{{ "index_looks_like" | i18n }}</p>

<figure class="image badge"><img width="120" height="22.64" src="https://img.shields.io/badge/html%20style-djLint-blue.svg" alt="https://github.com/djlint/djlint" /></figure>

</div>
<div class="container has-text-centered mb-5">
<h2 class="title is-2 mt-5">{{ "contributing" | i18n }}</h2>
<p class="has-text-left">
{{ "contributing_message" | i18n | safe }}</p>
</div>

<div class="container">
  <div class="is-flex is-justify-content-space-between mb-3">
    <span>{% gh_edit page %}</span>
    <em><small>{{ "updated" | i18n }} <strong>{{ page.date | niceDate }}</strong></small></em>
  </div>
</div>

{% endblock body %}
