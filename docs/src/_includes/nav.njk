{% set navUrl = page.url | baseUrl %}
{% set navItems = [
    ["/docs/getting-started/", "getting_started"],
    ["/docs/formatter/", "formatter"],
    ["/docs/linter/", "linter"],
    ["/docs/configuration/", "configuration"],
    ["/docs/integrations/", "integrations"],
    ["/docs/best-practices/", "best_practices"],
    ["/demo/", "try_online"]
] %}
<nav class="navbar djlint-nav is-fixed-top"
     aria-label="main navigation">
    <div class="container">
        <div class="navbar-brand">
            <a class="navbar-logo" href="{{ "lang_code_url" | i18n }}/"><picture><source srcset="/static/img/logo-wide-dark.svg" media="(prefers-color-scheme: dark)"><img src="/static/img/logo-wide-light.svg" alt="djLint" width="443" height="168"></picture></a>
            <a role="button"
               class="navbar-burger"
               aria-label="menu"
               aria-expanded="false"
               aria-controls="djlint-nav-menu"
               data-target="djlint-nav-menu">
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
            </a>
        </div>
        <div id="djlint-nav-menu" class="navbar-menu">
            <div class="navbar-start mx-0 is-justify-content-center is-flex-grow-1">
                {% for item in navItems %}
                <a class="navbar-item"{% if navUrl.startsWith(item[0]) %} aria-current="page"{% endif %} href="{{ "lang_code_url" | i18n }}{{ item[0] }}">{{ item[1] | i18n }}</a>
                {% endfor %}
            </div>
            <div class="navbar-end mx-0">
                <a class="navbar-item nav-icon"
                   href="https://github.com/djlint/djlint"
                   target="_blank"
                   rel="noopener"
                   aria-label="GitHub">
                    <span class="icon"><i class="fab fa-lg fa-github"></i></span>
                </a>
                <a class="navbar-item nav-icon"
                   href="https://discord.gg/taghAqebzU"
                   target="_blank"
                   rel="noopener"
                   aria-label="Discord">
                    <span class="icon"><i class="fab fa-lg fa-discord"></i></span>
                </a>
                <a class="navbar-item nav-icon"
                   href="https://pypi.org/project/djlint/"
                   target="_blank"
                   rel="noopener"
                   aria-label="PyPI">
                    <span class="icon"><i class="fas fa-lg fa-download"></i></span>
                </a>
                <div class="navbar-item has-dropdown is-hoverable">
                    <div class="navbar-link is-transparent">
                        <span class="icon"><i class="fas fa-globe"></i></span>
                        <span class="nav-lang-label">{{ locale | i18n_locale(locales) }}</span>
                    </div>
                    <div class="navbar-dropdown is-right">
                        {%  for page in page.url | i18n_urls(collections.all) %}
                            <a class="navbar-item" href="{{ page.url }}">{{ page.meta.label }}</a>
                        {%  endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</nav>
