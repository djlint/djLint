# File names here change with their content, so browsers may keep them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/filter/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/*.pf_meta
  Cache-Control: public, max-age=31536000, immutable
# The demo's djLint wheel: its version names the commit it was built from.
/static/py/*.whl
  Cache-Control: public, max-age=31536000, immutable

# Every response: no content sniffing, and no framing of the site by others.
# The rest of the pages' CSP is a <meta> that astro.config.mjs adds.
/*
  X-Content-Type-Options: nosniff
  Content-Security-Policy: frame-ancestors 'none'
