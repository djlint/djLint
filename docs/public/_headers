# File names under these paths change with their content, so browsers may keep them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/filter/*
  Cache-Control: public, max-age=31536000, immutable

# Every response: no content sniffing, and no framing of the site by others.
/*
  X-Content-Type-Options: nosniff
  Content-Security-Policy: frame-ancestors 'none'
