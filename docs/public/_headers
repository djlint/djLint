# Files with a hash in their name never change under it, so browsers can keep
# them; everything else revalidates, as Cloudflare does by default.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/fragment/*
  Cache-Control: public, max-age=31536000, immutable
/pagefind/index/*
  Cache-Control: public, max-age=31536000, immutable

# No content sniffing, and no framing of the site by others.
/*
  X-Content-Type-Options: nosniff
  Content-Security-Policy: frame-ancestors 'none'
