{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "branchTopic": "{{{depNameSanitized}}}-{{{newMajor}}}{{#if separateMinorPatch}}{{#if isPatch}}.{{{newMinor}}}{{/if}}{{/if}}{{#if separateMultipleMinor}}{{#if isMinor}}.{{{newMinor}}}{{/if}}{{/if}}.x",
  "configMigration": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "The mypyc build hook's pins and uv's constraints, which pep621 does not read. An update shares its branch with the pep621 one of the same package, so a pin moves with its uv.lock entry, and uv locks the new version under the moved constraint.",
      "managerFilePatterns": ["/^pyproject\\.toml$/"],
      "matchStrings": [
        "(?:\\[tool\\.hatch\\.build\\.targets\\.wheel\\.hooks\\.mypyc\\]\\ndependencies|constraint-dependencies) = \\[[^\\]]*\\]",
        "\"(?<depName>[^\"=]+)==(?<currentValue>[^\"]+)\""
      ],
      "matchStringsStrategy": "recursive",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "The Pyodide the demo on the website loads from the CDN.",
      "managerFilePatterns": ["/(^|/)static/js/worker\\.js$/"],
      "matchStrings": ["cdn\\.jsdelivr\\.net/pyodide/v(?<currentValue>[^/]+)/full/"],
      "depNameTemplate": "pyodide",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Keep CI on the newest Python: the version the tools run on and the last one the tests run on. The first test version is the oldest supported one, so it stays",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.yml$/"],
      "matchStrings": [
        "python-version: \"(?<currentValue>\\d+\\.\\d+)\"",
        "python-version:\\n +- \"\\d+\\.\\d+\"\\n +- \"(?<currentValue>\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "docker.io/python",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Add a classifier after the last one for each new Python version. The first match stops at the last classifier, the second takes the version out of it",
      "managerFilePatterns": ["/^pyproject\\.toml$/"],
      "matchStrings": [
        "classifiers = \\[[^\\]]*\"Programming Language :: Python :: \\d+\\.\\d+\",",
        "\"Programming Language :: Python :: (?<currentValue>\\d+\\.\\d+)\",$"
      ],
      "matchStringsStrategy": "recursive",
      "depNameTemplate": "docker.io/python",
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "\"Programming Language :: Python :: {{{currentValue}}}\",\n  \"Programming Language :: Python :: {{{newValue}}}\","
    }
  ],
  "dependencyDashboard": false,
  "extends": [
    "config:recommended",
    ":disableRateLimiting",
    ":pinDevDependencies",
    "helpers:pinGitHubActionDigests"
  ],
  "lockFileMaintenance": { "enabled": true, "schedule": ["at any time"] },
  "minimumReleaseAge": "3 days",
  "packageRules": [
    { "matchPackageNames": ["mypy", "pre-commit/mirrors-mypy"], "groupName": "mypy" },
    { "matchPackageNames": ["ruff", "charliermarsh/ruff-pre-commit"], "groupName": "ruff" },
    { "matchPackageNames": ["oxfmt", "oxc-project/mirrors-oxfmt"], "groupName": "oxfmt" },
    {
      "description": "The Pyodide that builds the demo's lock file and the one the demo loads from the CDN have to be the same",
      "matchPackageNames": ["pyodide"],
      "groupName": "pyodide"
    },
    { "matchCurrentVersion": "!/^0/", "matchUpdateTypes": ["minor"], "automerge": true },
    { "matchUpdateTypes": ["lockFileMaintenance", "patch", "replacement"], "automerge": true },
    { "matchDepTypes": ["dependency-groups"], "matchManagers": ["pep621"], "automerge": true },
    {
      "description": "Update a locked dependency in its own branch, which the mypyc build hook's pin of it joins, rather than only in lock file maintenance",
      "matchDepTypes": ["project.dependencies"],
      "matchManagers": ["pep621"],
      "rangeStrategy": "update-lockfile"
    },
    { "matchDepTypes": ["devDependencies"], "matchManagers": ["npm"], "automerge": true },
    { "matchManagers": ["github-actions", "pre-commit"], "automerge": true },
    {
      "description": "A new Node is reviewed by hand. Node versioning holds it back until the major version reaches LTS",
      "matchPackageNames": ["node"],
      "matchUpdateTypes": ["major"],
      "groupName": "node",
      "automerge": false
    },
    {
      "description": "A new Python is reviewed by hand. A cooldown would count from the last rebuild of an image tag, which keeps part of the update out of the PR. A classifier can name a Python that is not out yet, which is not a reason to roll it back",
      "matchPackageNames": ["python", "docker.io/python"],
      "groupName": "python",
      "automerge": false,
      "minimumReleaseAge": null,
      "rollbackPrs": false
    }
  ],
  "pre-commit": { "enabled": true },
  "rollbackPrs": true,
  "semanticCommits": "enabled"
}
